<div class="container mt-5">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <h2 class="text-primary">About Our Cafeteria</h2>

    <hr>

    <p>
        The University Cafeteria Supply Management System
        helps employees manage products, suppliers,
        and supply requests.
    </p>

    <p>
        Employees can submit supply requests by providing
        their name, product, quantity, and required date.
    </p>

</div>
