*@

@{

    string[] products = (string[])ViewData["Products"];
}

<div class="container mt-5">

    <h2 class="text-primary mb-4">
        @ViewData["Page_Title"]
    </h2>

    <div class="row mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="text-muted">Manager Name</h5>

                    <h4>
                        @ViewData["Manager_Name"]
                    </h4>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="text-muted">
                        Number of Products
                    </h5>

                    <h4>
                        @ViewData["Number_of_Products"]
                    </h4>

                </div>
            </div>
        </div>

    </div>

    <h4 class="mb-3">Product List</h4>

    <div class="row">

        @foreach (var product in products)
        {
            <div class="col-md-4 mb-3">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <h5 class="card-title">
                            @product
                        </h5>

                    </div>
                </div>

            </div>
        }

    </div>

</div>
