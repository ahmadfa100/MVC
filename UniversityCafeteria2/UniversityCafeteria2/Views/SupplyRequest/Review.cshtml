
@model UniversityCafeteria2.Models.ConfirmedRequest

@{
    ViewData["Title"] = "Review Draft";
}

<div class="container mt-4">

    <h2 class="mb-4">Review Supply Request</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-warning">
            Your supply request is empty.
        </div>

        <a href="@Url.Action("Index", "SupplyRequest")"
           class="btn btn-primary">
            Add Products
        </a>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h4>Products in Draft</h4>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">

                        <thead class="table-dark">
                            <tr>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Priority</th>
                                <th>Total Cost</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.Category</td>
                                    <td>@product.Quantity</td>
                                    <td>@product.UnitPrice.ToString("0.00") JD</td>
                                    <td>@product.Priority</td>
                                    <td>@product.TotalCost.ToString("0.00") JD</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h4 class="mb-3">Cost Summary</h4>

                <table class="table">

                    <tr>
                        <td>Subtotal</td>
                        <td>@Model.Subtotal.ToString("0.00") JD</td>
                    </tr>

                    <tr>
                        <td>Priority</td>
                        <td>@Model.Priority</td>
                    </tr>

                    <tr>
                        <td>Preparation Fee</td>
                        <td>@Model.PreparationFee.ToString("0.00") JD</td>
                    </tr>

                    <tr>
                        <td>Discount</td>
                        <td>@Model.Discount.ToString("0.00") JD</td>
                    </tr>

                    <tr class="table-success">
                        <th>Final Total</th>
                        <th>@Model.FinalTotal.ToString("0.00") JD</th>
                    </tr>

                </table>

                <form asp-controller="SupplyRequest"
                      asp-action="ConfirmRequest"
                      method="post">

                    <button type="submit" class="btn btn-success">
                        Confirm Request
                    </button>

                </form>

            </div>
        </div>
    }

    <a href="@Url.Action("Index", "SupplyRequest")"
       class="btn btn-primary">
        Add Another Product
    </a>

    <form asp-controller="SupplyRequest"
          asp-action="ClearDraft"
          method="post"
          class="d-inline">

        <button type="submit" class="btn btn-danger">
            Clear Draft
        </button>

    </form>

</div>
