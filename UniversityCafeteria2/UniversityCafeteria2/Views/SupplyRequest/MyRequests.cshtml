
@model List<UniversityCafeteria2.Models.ConfirmedRequest>

@{
    ViewData["Title"] = "My Requests";
}

<div class="container mt-4">

    <h2 class="mb-4">My Supply Requests</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No confirmed requests yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped table-hover">

                        <thead class="table-dark">
                            <tr>
                                <th>Request ID</th>
                                <th>Number of Products</th>
                                <th>Subtotal</th>
                                <th>Preparation Fee</th>
                                <th>Discount</th>
                                <th>Final Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>@request.RequestId</td>

                                    <td>@request.ProductCount</td>

                                    <td>
                                        @request.Subtotal.ToString("0.00") JD
                                    </td>

                                    <td>
                                        @request.PreparationFee.ToString("0.00") JD
                                    </td>

                                    <td>
                                        @request.Discount.ToString("0.00") JD
                                    </td>

                                    <td class="fw-bold">
                                        @request.FinalTotal.ToString("0.00") JD
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @request.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

    <a href="@Url.Action("Index", "SupplyRequest")"
       class="btn btn-primary mt-3">
        Create New Request
    </a>

</div>
