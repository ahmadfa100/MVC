
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - University Cafeteria</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        body {
            background-color: #f4f7fb;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #243247;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Main Navbar */

        .main-navbar {
            background: linear-gradient(110deg, #14263f, #234879);
            padding: 15px 0;
        }

        .main-navbar .navbar-brand {
            font-size: 22px;
            font-weight: 700;
            color: white;
        }

        .main-navbar .nav-link {
            color: #d8e3f1;
            font-weight: 500;
            padding: 9px 15px;
            border-radius: 7px;
            transition: 0.2s;
        }

        .main-navbar .nav-link:hover,
        .main-navbar .nav-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.13);
        }

        /* Supply Request Navbar */

        .feature-navbar {
            background: white;
            border-bottom: 1px solid #e1e7f0;
            box-shadow: 0 3px 12px rgba(0,0,0,0.04);
            padding: 10px 0;
        }

        .feature-navbar .navbar-brand {
            color: #254b84;
            font-size: 16px;
            font-weight: 700;
        }

        .feature-navbar .nav-link {
            color: #43536c;
            font-size: 14px;
            font-weight: 500;
            padding: 10px 14px;
            border-radius: 7px;
            transition: 0.2s;
        }

        .feature-navbar .nav-link:hover,
        .feature-navbar .nav-link.active {
            color: #205bb2;
            background: #edf4ff;
        }

        /* Main Content */

        .main-content {
            flex: 1;
            padding-top: 30px;
            padding-bottom: 45px;
        }

        .main-content h1,
        .main-content h2 {
            color: #17345a;
            font-weight: 700;
        }

        .main-content .card {
            border-radius: 14px;
            border: 1px solid #e5eaf2;
            box-shadow: 0 5px 18px rgba(24,48,82,0.05);
        }

        .main-content .form-control,
        .main-content .form-select {
            border-radius: 8px;
            padding: 10px 12px;
        }

        .main-content .form-control:focus,
        .main-content .form-select:focus {
            border-color: #4775b8;
            box-shadow: 0 0 0 3px rgba(71,117,184,0.12);
        }

        .main-content .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .main-content .table {
            vertical-align: middle;
        }

        /* Footer */

        .app-footer {
            background: white;
            border-top: 1px solid #e1e7f0;
            padding: 18px 0;
            color: #718096;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <!-- NAVBAR 1: Previous Cafeteria Pages -->

    <nav class="navbar navbar-expand-lg navbar-dark main-navbar">

        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Index", "Cafeteria")">
                University Cafeteria
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainMenu"
                    aria-controls="mainMenu"
                    aria-expanded="false"
                    aria-label="Toggle main navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Cafeteria")">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Products", "Cafeteria")">
                            Products
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Suppliers", "Cafeteria")">
                            Suppliers
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("SupplyStatus", "Cafeteria")">
                            Supply Status
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>


    <!-- NAVBAR 2: Supply Request Management -->

    <nav class="navbar navbar-expand-lg navbar-light feature-navbar">

        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Index", "SupplyRequest")">
                Supply Request Management
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#featureMenu"
                    aria-controls="featureMenu"
                    aria-expanded="false"
                    aria-label="Toggle feature navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="featureMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "SupplyRequest")">
                            Create Supply Request
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Review", "SupplyRequest")">
                            Review Draft
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("MyRequests", "SupplyRequest")">
                            My Requests
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("About", "SupplyRequest")">
                            About
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>


    <!-- Main Page Content -->

    <div class="container main-content">

        <main role="main">
            @RenderBody()
        </main>

    </div>


    <!-- Footer -->

    <footer class="app-footer">

        <div class="container d-flex justify-content-between flex-wrap gap-2">

            <span>
                &copy; @DateTime.Now.Year University Cafeteria
            </span>

            <span>
                Supply Request Management System
            </span>

        </div>

    </footer>


    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
