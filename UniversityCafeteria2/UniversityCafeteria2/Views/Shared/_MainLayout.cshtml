
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - University Cafeteria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
    <header class="bg-dark text-white p-3">
        <h2>University Cafeteria</h2>

        <nav>
            <a asp-controller="Cafeteria" asp-action="Index" class="text-white me-3">Home</a>

            <a asp-controller="Cafeteria" asp-action="Products" class="text-white me-3">Products</a>

            <a asp-controller="Cafeteria" asp-action="Suppliers" class="text-white me-3">Suppliers</a>

            <a asp-controller="Cafeteria" asp-action="SupplyStatus" class="text-white">Supply Status</a>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="text-center mt-5 p-3 bg-light">
        <p>University Cafeteria Management System</p>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
