
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cafeteria Manager</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/Home/Index">
                Cafeteria Manager
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Category/Index">Categories</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Supplier/Index">Suppliers</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Product/Index">Products</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Employee/Index">Employees</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Order/Index">Orders</a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <div class="container">
            <small>
                &copy; 2026 University Cafeteria Management System
            </small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
