
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <div class="bg-primary text-white rounded-3 p-5 mb-5 shadow-sm">
        <h1 class="fw-bold">University Cafeteria Management System</h1>
        <p class="lead mt-3 mb-0">
            Manage cafeteria products, categories, suppliers,
            employees, and customer orders in one place.
        </p>
    </div>

    <div class="mb-4">
        <h3 class="fw-bold">Management Dashboard</h3>
        <p class="text-muted">Select a section to manage cafeteria operations.</p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="text-primary">Categories</h4>
                    <p class="text-muted">
                        Organize and manage cafeteria product categories.
                    </p>
                    <a href="/Category/Index" class="btn btn-outline-primary">
                        Manage Categories
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="text-success">Suppliers</h4>
                    <p class="text-muted">
                        Manage supplier information and contact details.
                    </p>
                    <a href="/Supplier/Index" class="btn btn-outline-success">
                        Manage Suppliers
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="text-info">Products</h4>
                    <p class="text-muted">
                        Manage products, prices, quantities, and stock.
                    </p>
                    <a href="/Product/Index" class="btn btn-outline-info">
                        Manage Products
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="text-warning">Employees</h4>
                    <p class="text-muted">
                        Manage employees and their job information.
                    </p>
                    <a href="/Employee/Index" class="btn btn-outline-warning">
                        Manage Employees
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="text-danger">Orders</h4>
                    <p class="text-muted">
                        Manage customer orders, totals, and order status.
                    </p>
                    <a href="/Order/Index" class="btn btn-outline-danger">
                        Manage Orders
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
