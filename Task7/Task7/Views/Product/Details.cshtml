@model Product

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header bg-info">
            <h4 class="mb-0">Product Details</h4>
        </div>

        <div class="card-body">
            <p><strong>ID:</strong> @Model.Id</p>
            <p><strong>Name:</strong> @Model.Name</p>
            <p><strong>Description:</strong> @Model.Description</p>
            <p><strong>Price:</strong> @Model.Price</p>
            <p><strong>Quantity:</strong> @Model.Quantity</p>
            <p><strong>Category:</strong> @Model.Category.Name</p>
            <p><strong>Supplier:</strong> @Model.Supplier.Name</p>
            <p><strong>Stock:</strong> @(Model.Quantity < 5 ? "Low Stock" : "In Stock")</p>

            <a href="/Product/Edit/@Model.Id" class="btn btn-warning">Edit</a>
            <a href="/Product/Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

</div>
