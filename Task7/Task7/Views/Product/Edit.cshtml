@model Product

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h4 class="mb-0">Edit Product</h4>
        </div>

        <div class="card-body">

            <form action="/Product/Edit/@Model.Id" method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <label class="form-label">Name</label>
                <input type="text" name="Name" value="@Model.Name" class="form-control mb-3" required />

                <label class="form-label">Description</label>
                <textarea name="Description" class="form-control mb-3" rows="3" required>@Model.Description</textarea>

                <label class="form-label">Price</label>
                <input type="number" name="Price" value="@Model.Price" min="0" step="0.01" class="form-control mb-3" required />

                <label class="form-label">Quantity</label>
                <input type="number" name="Quantity" value="@Model.Quantity" min="0" class="form-control mb-3" required />

                <label class="form-label">Category</label>
                <select name="CategoryId" class="form-control mb-3" required>
                    <option value="">Select Category</option>
                    @foreach (Category category in ViewBag.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                    }
                </select>

                <label class="form-label">Supplier</label>
                <select name="SupplierId" class="form-control mb-3" required>
                    <option value="">Select Supplier</option>
                    @foreach (Supplier supplier in ViewBag.Suppliers)
                    {
                        <option value="@supplier.Id" selected="@(supplier.Id == Model.SupplierId)">@supplier.Name</option>
                    }
                </select>

                <button type="submit" class="btn btn-warning">Update Product</button>
                <a href="/Product/Index" class="btn btn-secondary">Cancel</a>

            </form>

        </div>
    </div>

</div>
