@model List<Employee>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Employees</h2>
        <a href="/Employee/Create" class="btn btn-primary">+ Add Employee</a>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Position</th>
                <th>Salary</th>
                <th>Hire Date</th>
                <th>Orders Count</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Email</td>
                    <td>@employee.Position</td>
                    <td>@employee.Salary</td>
                    <td>@employee.HireDate.ToShortDateString()</td>
                    <td>@employee.Orders.Count</td>
                    <td>
                        <a href="/Employee/Edit/@employee.Id" class="btn btn-warning btn-sm">Edit</a>

                        <a href="/Employee/Details/@employee.Id" class="btn btn-info btn-sm">Details</a>

                        <form action="/Employee/Delete/@employee.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
