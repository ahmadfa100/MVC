@model Order

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header bg-info">
            <h4 class="mb-0">Order Details</h4>
        </div>

        <div class="card-body">
            <p><strong>ID:</strong> @Model.Id</p>
            <p><strong>Customer Name:</strong> @Model.CustomerName</p>
            <p><strong>Order Date:</strong> @Model.OrderDate.ToShortDateString()</p>
            <p><strong>Total Price:</strong> @Model.TotalPrice</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Employee:</strong> @Model.Employee.FullName</p>

            <a href="/Order/Edit/@Model.Id" class="btn btn-warning">Edit</a>
            <a href="/Order/Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

</div>
