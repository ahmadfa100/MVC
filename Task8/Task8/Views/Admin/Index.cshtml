@model List<UserFromIdentity>
@{
    ViewData["Title"] = "Users";
}

<div class="mb-4">
    <h1 class="h2 mb-1">User Management</h1>
    <p class="text-muted mb-0">Manage cafeteria accounts and roles.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted p-4 mb-0">No users found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (UserFromIdentity user in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@user.FullName</td>
                                <td>@user.Email</td>
                                <td class="text-end text-nowrap">
                                    @if (user.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                    {
                                        <a href="/Admin/Edit/@user.Id" class="btn btn-outline-primary btn-sm">Change Role</a>
                                        <form action="/Admin/Delete/@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this user?')">Delete</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Your account</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
