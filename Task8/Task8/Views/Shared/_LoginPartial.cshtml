<ul class="navbar-nav align-items-lg-center gap-lg-2">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item"><span class="navbar-text text-white-50">Hello, @User.Identity.Name</span></li>
        <li class="nav-item">
            <form action="/Account/Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light btn-sm">Log Out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" href="/Account/Login">Log In</a></li>
        <li class="nav-item"><a class="btn btn-light btn-sm" href="/Account/Register">Register</a></li>
    }
</ul>
