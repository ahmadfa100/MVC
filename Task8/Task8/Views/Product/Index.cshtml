@model List<Product>
@{
    ViewData["Title"] = "Products";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Products</h1>
        <p class="text-muted mb-0">Browse the cafeteria supply catalog.</p>
    </div>
    @if (canManage)
    {
        <a href="/Product/Create" class="btn btn-primary">+ Add Product</a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h2 class="h5">No products yet</h2>
                <p class="text-muted mb-0">Products will appear here when they are added.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Available</th>
                            <th>Stock</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Product product in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@product.Name</td>
                                <td class="text-muted">@product.Description</td>
                                <td>@product.Price.ToString("0.00")</td>
                                <td>@product.Quantity.ToString("0.##")</td>
                                <td>
                                    @if (product.Quantity <= 0)
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                    else if (product.Quantity < 5)
                                    {
                                        <span class="badge bg-warning text-dark">Low stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In stock</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="/Product/Details/@product.Id" class="btn btn-outline-primary btn-sm">Details</a>
                                    @if (canManage)
                                    {
                                        <a href="/Product/Edit/@product.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                        <form action="/Product/Delete/@product.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this product?')">Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
