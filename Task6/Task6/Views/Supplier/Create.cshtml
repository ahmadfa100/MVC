
<h2>Add Supplier</h2>

<form asp-action="Create" asp-controller="Supplier" method="post">

    <label>Name</label>
    <input name="Name" class="form-control mb-3" />

    <label>Phone</label>
    <input name="Phone" class="form-control mb-3" />

    <label>Email</label>
    <input name="Email" class="form-control mb-3" />

    <button type="submit" class="btn btn-primary">Submit</button>

</form>
