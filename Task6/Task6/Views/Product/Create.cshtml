
<h2>Add Product</h2>

<form asp-action="Create" asp-controller="Product" method="post">

    <label>Name</label>
    <input name="Name" class="form-control mb-3" />

    <label>Price</label>
    <input type="number" step="0.01" name="Price" class="form-control mb-3" />

    <label>Quantity</label>
    <input type="number" name="Quantity" class="form-control mb-3" />

    <label>Category ID</label>
    <input type="number" name="CategoryId" class="form-control mb-3" />

    <label>Supplier ID</label>
    <input type="number" name="SupplierId" class="form-control mb-3" />

    <button type="submit" class="btn btn-primary">Submit</button>

</form>
