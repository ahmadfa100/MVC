@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - University Cafeteria</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Task6.styles.css" asp-append-version="true" />

    <style>
            body {
                background-color: #f4f7fb;
                color: #243247;
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            .app-navbar {
                background: #172b45;
                padding: 15px 0;
                box-shadow: 0 3px 12px rgba(0,0,0,0.10);
            }

            .navbar-brand {
                color: white !important;
                font-weight: 700;
                font-size: 21px;
                letter-spacing: 0.3px;
            }

            .brand-icon {
                background: #14b8a6;
                color: white;
                padding: 9px 11px;
                border-radius: 9px;
                margin-right: 9px;
                font-size: 15px;
            }

            .app-navbar .nav-link {
                color: #d3deea !important;
                font-weight: 500;
                margin: 0 7px;
                padding: 9px 13px !important;
                border-radius: 7px;
                transition: 0.2s;
            }

                .app-navbar .nav-link:hover,
                .app-navbar .nav-link.active {
                    background: rgba(255,255,255,0.12);
                    color: white !important;
                }

            .btn-create {
                background: #14b8a6;
                color: white;
                border: none;
                border-radius: 8px;
                padding: 9px 18px;
                font-weight: 600;
            }

                .btn-create:hover,
                .btn-create:focus {
                    background: #0d9488;
                    color: white;
                }

            .app-main {
                padding-top: 35px;
                padding-bottom: 50px;
            }

            .page-heading {
                font-weight: 700;
                color: #172b45;
            }

            .card {
                border: 1px solid #e6ebf1;
                border-radius: 12px;
                box-shadow: 0 3px 12px rgba(0,0,0,0.035);
            }

            .table {
                background: white;
                vertical-align: middle;
            }

                .table thead {
                    background: #172b45;
                    color: white;
                }

                .table th,
                .table td {
                    padding: 13px 16px;
                }

            .form-control,
            .form-select {
                border-radius: 7px;
                padding: 10px 13px;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #14b8a6;
                    box-shadow: 0 0 0 0.2rem rgba(20,184,166,0.15);
                }

            .app-footer {
                background: white;
                border-top: 1px solid #e5eaf0;
                padding: 20px 0;
                color: #7b8798;
                font-size: 14px;
            }

            .footer-title {
                color: #172b45;
                font-weight: 700;
            }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">UC</span>
                    Cafeteria Manager
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Category" ? "active" : "")"
                               asp-controller="Category"
                               asp-action="Index">
                                Categories
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Supplier" ? "active" : "")"
                               asp-controller="Supplier"
                               asp-action="Index">
                                Suppliers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Product" ? "active" : "")"
                               asp-controller="Product"
                               asp-action="Index">
                                Products
                            </a>
                        </li>

                        <li class="nav-item dropdown ms-lg-3">
                            <button class="btn btn-create dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                + Add New
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-controller="Category"
                                       asp-action="Create">
                                        Add Category
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-controller="Supplier"
                                       asp-action="Create">
                                        Add Supplier
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-controller="Product"
                                       asp-action="Create">
                                        Add Product
                                    </a>
                                </li>

                            </ul>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container app-main flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer mt-auto">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

                <div>
                    <span class="footer-title">University Cafeteria</span>
                    <span class="ms-2">Management System</span>
                </div>

                <div>
                    &copy; 2026 Task6. All rights reserved.
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
